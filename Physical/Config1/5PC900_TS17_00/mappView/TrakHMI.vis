<?xml version="1.0" encoding="utf-8"?>
<vdef:Visualization id="TrakHMI" autoUpdate="true" xmlns:vdef="http://www.br-automation.com/iat2015/visualizationDefinition/v2">
  <StartPage pageRefId="Main" />
  <Pages>
    <Page refId="Main" />
  </Pages>
  <Navigations />
  <BindingsSets>
    <BindingsSet refId="ContentMain" />
  </BindingsSets>
  <EventBindingsSets>
    <EventBindingsSet refId="ContentMain" />
  </EventBindingsSets>
  <Dialogs />
  <Contents>
    <Content refId="ContentHeader" />
    <Content refId="ContentMain" />
  </Contents>
  <SnippetsSets />
  <VariablesSets />
  <ExpressionsSets />
  <StartTheme themeRefId="BuR_Theme_ABB_Light" />
  <Themes>
    <Theme refId="BuR_Theme_ABB_Light" />
    <Theme refId="BuR_Theme_ABB_Dark" />
  </Themes>
  <Configurations>
    <Configuration key="activityCount" value="false" />
    <Configuration key="zoom" value="true" />
    <Gestures>
      <!--<SystemGesture1 touchPoints="2" />
			<SystemGesture2 touchPoints="2" />
			<SystemGesture3 touchPoints="2" />-->
    </Gestures>
    <VirtualKeyboards>
      <!--<InputProcessing onKeyDown="true" />-->
    </VirtualKeyboards>
  </Configurations>
</vdef:Visualization>